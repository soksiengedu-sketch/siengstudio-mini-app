{
  "name": "siengstudio-mini-app",
  "version": "1.0.0",
  "description": "SiengStudio - Telegram Mini App & Bot for Short Dramas, Video Recaps & Series Streaming (Clone of Phsar Roeung)",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "dev:client": "vite",
    "dev:server": "node server/index.js",
